{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/wikijump/wikijump",
        "sources": "https://github.com/wikijump/wikijump"
    },
    "license": "${license}",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.wikijump.fabric.WikiJumpFabricClient"
        ],
        "modmenu": [
            "com.wikijump.fabric.WikiJumpModMenu"
        ]
    },
    "suggests": {
        "modmenu": "*"
    },
    "accessWidener": "${mod_id}.accesswidener",
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${fabric_minecraft_dep}",
        "java": ">=${java_version}"
    }
}
